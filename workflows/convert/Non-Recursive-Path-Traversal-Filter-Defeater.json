            "alias": "code",
            "value": {
              "data": "/**\n * @param {NodeInput} input\n * @param {SDK} sdk\n * @returns {MaybePromise<NodeResult | Data>}\n */\n  export function run({ data, extra }, sdk) {\n    let parsed = sdk.asString(data);\n\n    // Jedes \"../\" -> \"....//\"  (defeats non-recursive search-and-replace)\n    let mutated = parsed.replace(/\\.\\.\\//g, \"....//\");\n\n    sdk.console.log(`[traversal-convert] ${parsed} -> ${mutated}`);\n\n    return {\n      data: mutated,\n      extra\n    };\n  }",
              "kind": "string"
            }
          }
        ],
        "name": "Non-Recursive-Path-Traversal-Filter-Defeater",
