          {
            "alias": "code",
            "value": {
              "data": "/**\n * @param {NodeInput} input\n * @param {SDK} sdk\n * @returns {MaybePromise<NodeResult | Data>}\n */\nexport function run({ data, extra }, sdk) {\n    let parsed = sdk.asString(data);\n    // Jede zusammenhängende Folge von %XX einzeln decoden.\n    // Ungültige Sequenzen (z.B. %zz oder ein abgeschnittenes %c3) bleiben roh, statt den ganzen Workflow abzubrechen.\n    let out = parsed.replace(/(%[0-9a-fA-F]{2})+/g, (seq) => {\n      try {\n        return decodeURIComponent(seq);\n      } catch (e) {\n        return seq;\n      }\n    });\n    sdk.console.log(out);\n    return {\n      data: out,    \n      extra\n    };\n  }\n",
              "kind": "string"
            }
          }
        ],
